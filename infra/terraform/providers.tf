terraform {
  required_version = ">= 1.5"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# Authenticates via Application Default Credentials
# (`gcloud auth application-default login`). No service-account key is checked in.
provider "google" {}

# Firebase resources live in the google-beta provider.
provider "google-beta" {}
