{
  "name": "chat-evolve",
  "version": "0.1.0",
  "private": true,
  "description": "ChatEvolve: evolutionary LLM interface (Helix). Monorepo: UI component library + Next.js app, deployed to Firebase Hosting.",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "storybook": "pnpm --filter @chat-evolve/ui storybook",
    "build-storybook": "pnpm --filter @chat-evolve/ui build-storybook"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
